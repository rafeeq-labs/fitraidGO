{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/js",
    "paths": {
      "three": ["./types/three/index.d.ts"],
      "earcut": ["./types/earcut.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
