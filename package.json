{
  "name": "raidfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RaidFit — GPS fitness MMO. Real-world map geography rendered as a painterly isometric fantasy world in Three.js.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "serve": "http-server . -a 127.0.0.1 -p 8231 -c-1",
    "author": "node tools/author-bath.mjs",
    "tile": "node tools/build-tile.mjs",
    "test": "node --test \"tools/tests/*.test.mjs\"",
    "shoot": "NODE_PATH=/opt/node22/lib/node_modules node tools/capture.mjs"
  }
}
